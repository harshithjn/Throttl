{
    "dashboard": {
        "id": null,
        "title": "Throttl System Health",
        "tags": [
            "throttl",
            "system",
            "health"
        ],
        "style": "dark",
        "timezone": "browser",
        "refresh": "30s",
        "time": {
            "from": "now-1h",
            "to": "now"
        },
        "panels": [
            {
                "id": 1,
                "title": "Memory Usage",
                "type": "timeseries",
                "targets": [
                    {
                        "expr": "throttl_memory_usage_bytes",
                        "legendFormat": "{{component}}"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "color": {
                            "mode": "palette-classic"
                        },
                        "unit": "bytes"
                    }
                },
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 0
                }
            },
            {
                "id": 2,
                "title": "Goroutines",
                "type": "timeseries",
                "targets": [
                    {
                        "expr": "throttl_goroutines",
                        "legendFormat": "Goroutines"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "color": {
                            "mode": "palette-classic"
                        },
                        "unit": "short"
                    }
                },
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 0
                }
            },
            {
                "id": 3,
                "title": "Database Connections",
                "type": "timeseries",
                "targets": [
                    {
                        "expr": "throttl_database_connections",
                        "legendFormat": "{{database}} - {{state}}"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "color": {
                            "mode": "palette-classic"
                        },
                        "unit": "short"
                    }
                },
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 8
                }
            },
            {
                "id": 4,
                "title": "Redis Connections",
                "type": "timeseries",
                "targets": [
                    {
                        "expr": "throttl_redis_connections",
                        "legendFormat": "{{state}}"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "color": {
                            "mode": "palette-classic"
                        },
                        "unit": "short"
                    }
                },
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 8
                }
            },
            {
                "id": 5,
                "title": "Database Operation Latency",
                "type": "timeseries",
                "targets": [
                    {
                        "expr": "histogram_quantile(0.95, sum(rate(throttl_database_operation_duration_seconds_bucket[5m])) by (le, operation))",
                        "legendFormat": "{{operation}} p95"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "color": {
                            "mode": "palette-classic"
                        },
                        "unit": "s"
                    }
                },
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 16
                }
            },
            {
                "id": 6,
                "title": "Redis Operation Latency",
                "type": "timeseries",
                "targets": [
                    {
                        "expr": "histogram_quantile(0.95, sum(rate(throttl_redis_operation_duration_seconds_bucket[5m])) by (le, operation))",
                        "legendFormat": "{{operation}} p95"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "color": {
                            "mode": "palette-classic"
                        },
                        "unit": "s"
                    }
                },
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 16
                }
            },
            {
                "id": 7,
                "title": "Error Rate",
                "type": "timeseries",
                "targets": [
                    {
                        "expr": "sum(rate(throttl_errors_total[5m])) by (error_type, component)",
                        "legendFormat": "{{component}} - {{error_type}}"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "color": {
                            "mode": "palette-classic"
                        },
                        "unit": "reqps"
                    }
                },
                "gridPos": {
                    "h": 8,
                    "w": 24,
                    "x": 0,
                    "y": 24
                }
            }
        ]
    }
}
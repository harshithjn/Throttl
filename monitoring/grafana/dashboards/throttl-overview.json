{
    "dashboard": {
        "id": null,
        "title": "Throttl Rate Limiting Overview",
        "tags": [
            "throttl",
            "rate-limiting"
        ],
        "style": "dark",
        "timezone": "browser",
        "refresh": "30s",
        "time": {
            "from": "now-1h",
            "to": "now"
        },
        "panels": [
            {
                "id": 1,
                "title": "Request Rate",
                "type": "stat",
                "targets": [
                    {
                        "expr": "sum(rate(throttl_requests_allowed_total[5m]))",
                        "legendFormat": "Allowed/sec"
                    },
                    {
                        "expr": "sum(rate(throttl_requests_blocked_total[5m]))",
                        "legendFormat": "Blocked/sec"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "color": {
                            "mode": "palette-classic"
                        },
                        "unit": "reqps"
                    }
                },
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 0
                }
            },
            {
                "id": 2,
                "title": "Success Rate",
                "type": "stat",
                "targets": [
                    {
                        "expr": "sum(rate(throttl_requests_allowed_total[5m])) / (sum(rate(throttl_requests_allowed_total[5m])) + sum(rate(throttl_requests_blocked_total[5m]))) * 100",
                        "legendFormat": "Success Rate %"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "color": {
                            "mode": "thresholds"
                        },
                        "thresholds": {
                            "steps": [
                                {
                                    "color": "red",
                                    "value": 0
                                },
                                {
                                    "color": "yellow",
                                    "value": 70
                                },
                                {
                                    "color": "green",
                                    "value": 90
                                }
                            ]
                        },
                        "unit": "percent"
                    }
                },
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 0
                }
            },
            {
                "id": 3,
                "title": "Request Latency",
                "type": "timeseries",
                "targets": [
                    {
                        "expr": "histogram_quantile(0.50, sum(rate(throttl_request_latency_seconds_bucket[5m])) by (le))",
                        "legendFormat": "p50"
                    },
                    {
                        "expr": "histogram_quantile(0.95, sum(rate(throttl_request_latency_seconds_bucket[5m])) by (le))",
                        "legendFormat": "p95"
                    },
                    {
                        "expr": "histogram_quantile(0.99, sum(rate(throttl_request_latency_seconds_bucket[5m])) by (le))",
                        "legendFormat": "p99"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "color": {
                            "mode": "palette-classic"
                        },
                        "unit": "s"
                    }
                },
                "gridPos": {
                    "h": 8,
                    "w": 24,
                    "x": 0,
                    "y": 8
                }
            },
            {
                "id": 4,
                "title": "Requests by Algorithm",
                "type": "timeseries",
                "targets": [
                    {
                        "expr": "sum(rate(throttl_requests_allowed_total[5m])) by (algorithm)",
                        "legendFormat": "{{algorithm}} - Allowed"
                    },
                    {
                        "expr": "sum(rate(throttl_requests_blocked_total[5m])) by (algorithm)",
                        "legendFormat": "{{algorithm}} - Blocked"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "color": {
                            "mode": "palette-classic"
                        },
                        "unit": "reqps"
                    }
                },
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 16
                }
            },
            {
                "id": 5,
                "title": "Top Clients by Request Volume",
                "type": "timeseries",
                "targets": [
                    {
                        "expr": "topk(10, sum(rate(throttl_requests_allowed_total[5m]) + rate(throttl_requests_blocked_total[5m])) by (client_id))",
                        "legendFormat": "{{client_id}}"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "color": {
                            "mode": "palette-classic"
                        },
                        "unit": "reqps"
                    }
                },
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 16
                }
            },
            {
                "id": 6,
                "title": "HTTP Status Codes",
                "type": "timeseries",
                "targets": [
                    {
                        "expr": "sum(rate(throttl_http_requests_total[5m])) by (status_code)",
                        "legendFormat": "{{status_code}}"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "color": {
                            "mode": "palette-classic"
                        },
                        "unit": "reqps"
                    }
                },
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 24
                }
            },
            {
                "id": 7,
                "title": "Authentication Failures",
                "type": "timeseries",
                "targets": [
                    {
                        "expr": "sum(rate(throttl_api_key_auth_failures_total[5m])) by (reason)",
                        "legendFormat": "{{reason}}"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "color": {
                            "mode": "palette-classic"
                        },
                        "unit": "reqps"
                    }
                },
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 24
                }
            }
        ]
    }
}